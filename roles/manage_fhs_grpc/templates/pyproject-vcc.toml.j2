[project]
name = "ska_mid_cbf_fhs_vcc_grpc_controller"
version = "0.0.3"
description = "SKA Mid.CBF FHS FSP gRPC Controller"
authors = [
  { name = "Jason Turner", email = "jason.turner@mda.space" },
]
license = "BSD license"
readme = "README.md"


[tool.poetry.scripts]
ska-mid-cbf-fhs-vcc-grpc-controller = "ska_mid_cbf_fhs_vcc_grpc_controller.server:run"

[tool.poetry.dependencies]
python = ">=3.10,<3.15"
typing-extensions = "^4.8.0"
pyyaml = "^6.0.1"
dataclasses-json = "^0.6.7"
debugpy = "^1.8.5"
grpcio = "^1.62.0"
grpcio-tools = "^1.62.0"
protobuf = "^4.25.0"
python-json-logger = "^2.0.7"
grpcio-health-checking = "^1.62.0"
jsonref = "1.1.0"
certifi = "2026.5.20"
idna = "3.15"
markupsafe = "3.0.3"
urllib3 = "2.7.0"

[tool.poetry.group.dev.dependencies]
pytest-pydocstyle = "2.3.2"
pytest-pycodestyle = "2.3.1"
pytest = "8.3.1"
pytest-bdd = "^7.2.0"
pytest-cov = "^5.0.0"
pytest-forked = "^1.6.0"
pytest-json-report = "^1.5.0"
pytest-mock = "^3.14.0"
pytest-xdist = "^3.6.1"
pytest-repeat = "^0.9.3"
pytest-pylint = "^0.21.0"
pylint = "3.2.6"
pylint-junit = "0.3.4"
flake8-quotes = "^3.4.0"
flake8-annotations = "^3.0.1"
flake8-import-conventions = "0.1.0"
flake8-pep585 = "0.1.7"
flake8-bugbear = "24.12.12"

[[tool.poetry.source]]
name = "pypy-proxy"
url = "{{pip_index_url}}"
priority = "primary"

[build-system]
requires = ["poetry>=2.0", "poetry-core>=2.0.1"]
build-backend = "poetry.core.masonry.api"