[Unit]
Description=fsp-grpc

[Service]
WorkingDirectory=/opt/grpc/fsp/{{ manage_grpc_fsp_controller }}

ExecStart=/opt/venvs/fhs/bin/python /opt/venvs/fhs/bin/poetry run ska-mid-cbf-fhs-fsp-grpc-controller --device {{ manage_grpc_device_address }} --card {{ manage_grpc_card }} --region {{ manage_grpc_device_region }} --bitstream_pkg_path /opt/bitstreams/{{ manage_grpc_fsp_bitstream }}/raw/ska-mid-cbf-agilex-vcc --log info{% if manage_grpc_emulation_mode == "true"%} --emulation_mode{% endif %}

Environment="PYTHONPATH=/opt/venvs/fhs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:/opt/bitstreams/{{ manage_grpc_vcc_bitstream }}/raw/ska-mid-cbf-agilex-vcc/drivers/fpga_driver_common/driver:/opt/bitstreams/{{ manage_grpc_fsp_bitstream }}/raw/ska-mid-cbf-agilex-vcc/drivers/"

[Install]
WantedBy=multi-user.target
