[project]
name = "ska_mid_cbf_fhs_fsp_grpc_controller"
version = "0.0.3"
description = "SKA Mid.CBF FHS FSP gRPC Controller"
authors = [
  { name = "Jason Turner", email = "jason.turner@mda.space" },
]
license = "BSD license"
readme = "README.md"

[tool.poetry.scripts]
ska-mid-cbf-fhs-fsp-grpc-controller = "ska_mid_cbf_fhs_fsp_grpc_controller.server:run"

[tool.poetry.dependencies]
python = ">=3.10,<3.15"
typing-extensions = "^4.8.0"
pyyaml = "^6.0.1"
dataclasses-json = "^0.6.7"
debugpy = "^1.8.5"
grpcio = "^1.81.0"
grpcio-tools = "^1.81.0"
protobuf = "^6.33.0"
pydantic-settings = "^2.2.0"
structlog = "^24.1.0"
python-json-logger = "^2.0.7"
grpcio-health-checking = "^1.62.0"
click = "^8.3.1"
#optional prometheus exporter
#grpcio-prometheus>=0.11.0"

[[tool.poetry.source]]
name = "pypy-proxy"
url = "{{pip_index_url}}"
priority = "primary" 

[tool.isort]
profile = "black"

[tool.black]
line-length = 130

[build-system]
requires = ["poetry>=2.0", "poetry-core>=2.0.1"]
build-backend = "poetry.core.masonry.api"