{{ ansible_managed | comment }}
global:
  scrape_interval: {{ manage_prometheus_scrape_interval }}
  evaluation_interval: {{ manage_prometheus_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          # - alertmanager:9093


rule_files:
  - "/etc/prometheus/rules/*_rules.yml"

  
scrape_configs:
  - job_name: 'dynamic_exporters'
    file_sd_configs:
      - files:
          - '/etc/prometheus/targets/*.json'
          - '/etc/prometheus/targets/*.yml'
          - '/etc/prometheus/targets/*.yaml'
  - job_name: node
    static_configs:
      - targets: ['localhost:9100']
        labels:
          app: "node"
