# bifrost-infra/.env  (this file is OPTIONAL)
#
# Copy to `.env` ONLY if the Docker daemon sees a different filesystem from
# your shell — typically Docker Desktop on Windows accessing WSL2, where the
# daemon-visible prefix differs from the WSL paths. In that case, set each
# variable below to the absolute path the daemon should bind-mount from.
#
# For native Linux or WSL2 + Docker Engine (no Docker Desktop), leave this
# file unused: `docker-compose.yml` defaults every path relative to the
# compose file, which resolves correctly without configuration.
#
# To find the daemon-visible prefix on Docker Desktop:
#   sudo docker inspect <any-running-container> | grep -A2 '"Source"'
#
# Example (Docker Desktop on Windows, repo cloned under /home/ubuntu):
#   BIFROST_DIR=/mnt/wsl/.../home/ubuntu/ska-mid-cbf-fhs-baremetal/bifrost-infra
#   INVENTORY_DIR=/mnt/wsl/.../home/ubuntu/ska-mid-cbf-fhs-baremetal/inventory
#   VAULT_PASS_FILE=/mnt/wsl/.../home/ubuntu/ska-mid-cbf-fhs-baremetal/.vault_pass


# BIFROST_DIR=

# INVENTORY_DIR=

# VAULT_PASS_FILE=

# PLAYBOOKS_DIR=

# RESOURCES_DIR=

# SCRIPTS_DIR=
