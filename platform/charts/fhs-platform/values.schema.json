{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "hostname",
        "urlPrefix",
        "scheme",
        "ingressClassName"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
        },
        "urlPrefix": {
          "type": "string",
          "pattern": "^(|/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/?)$"
        },
        "scheme": {
          "enum": [
            "https",
            "http"
          ]
        },
        "ingressClassName": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecretName": {
          "type": "string"
        },
        "ingressAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "discovery": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "refreshInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(s|m)$"
            },
            "nodeTag": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "fhsTag": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "selector": {
              "enum": [
                "customField",
                "tags"
              ]
            },
            "customField": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "netboxEmail": {
          "type": "string"
        }
      }
    },
    "landing": {
      "type": "object",
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aptCacher": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
